# Database connection string (PostgreSQL/Supabase)
ConnectionStrings__ConexDb=Host=your-host;Port=5432;Database=postgres;Username=your-user;Password=your-password

# Supabase URL for JWT authentication
Supabase__Url=https://your-project.supabase.co

# Upstash Redis (optional - for SignalR backplane)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
